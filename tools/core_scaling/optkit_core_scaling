#!/bin/bash

# Help function
print_help() {
    cat <<EOF
Usage: $0 [OPTIONS] -c COMMAND [ARGS...]

Options:
  -s, --socket SOCKET_NUM   Specify socket to use (can be used multiple times, default 0)
  -c, --command COMMAND     Command to execute with CPU binding
  --strategy STRATEGY       Core allocation strategy [balanced|sequential]
  --help                    Display this help message

Strategies:
  balanced     Distribute threads evenly across sockets (default)
  sequential   Fill complete sockets before using next socket

EOF
    # Show socket information
    echo "-------"
    for socket in "${!SOCKET_CPUS[@]}"; do
        echo "Socket $socket CPUs: ${SOCKET_CPUS[$socket]}"
    done | sort -n
    echo "-------"
}

# Initialize variables
declare -A SOCKET_CPUS
declare -a sockets
command=""
STRATEGY="balanced"

# Function to detect all available sockets and their CPUs
detect_sockets() {
    while read -r socket_info; do
        if [[ $socket_info =~ node\ ([0-9]+)\ cpus:\ (.+) ]]; then
            SOCKET_CPUS["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
        fi
    done < <(numactl --hardware 2>/dev/null)
}

# Function to get NUMA node for a core
get_numa_node() {
    local core=$1
    numactl --hardware | awk -v core="$core" '
        /node [0-9]+ cpus:/ {
            node = $2;
            split($0, parts, ":");
            split(parts[2], cpus, " ");
            for (i in cpus) {
                if (cpus[i] == core) {
                    print node;
                    exit;
                }
            }
        }'
}

# Function to get balanced core distribution
get_balanced_cores() {
    local threads=$1
    local -n _socket_cores=$2
    declare -a selected
    declare -A tmp_cores
    
    # Create working copy
    for node in "${!_socket_cores[@]}"; do
        tmp_cores[$node]="${_socket_cores[$node]}"
    done

    while (( ${#selected[@]} < threads )); do
        for node in "${!tmp_cores[@]}"; do
            IFS=' ' read -ra cores <<< "${tmp_cores[$node]}"
            if (( ${#cores[@]} > 0 )); then
                selected+=("${cores[0]}")
                tmp_cores[$node]="${cores[@]:1}"
                (( ${#selected[@]} >= threads )) && break 2
            fi
        done
    done

    printf "%s" "${selected[*]}" | tr ' ' ','
}

# Function to get sequential core distribution
get_sequential_cores() {
    local threads=$1
    local -n _all_cores=$2
    printf "%s" "${_all_cores[*]:0:$threads}" | tr ' ' ','
}

# Main benchmark function
run_benchmark() {
    local cores=$1
    local max_cores=$2
    local command=$3

    IFS=',' read -ra core_array <<< "$cores"
    local total_cores=${#core_array[@]}

    # Group cores by NUMA node
    declare -A socket_cores
    for core in "${core_array[@]}"; do
        node=$(get_numa_node "$core")
        socket_cores[$node]+=" $core"
    done

    echo "CPU Cores: ${cores}"
    echo "Total Cores: ${total_cores}"
    echo "NUMA Nodes: ${!socket_cores[@]}"
    echo "Strategy: ${STRATEGY}"
    echo "Command: ${command}"
    echo "----------------------------------------"

    case $STRATEGY in
        balanced)
            # Distribute threads round-robin across sockets
            for ((threads=1; threads<=total_cores; threads++)); do
                selected_cores=$(get_balanced_cores "$threads" socket_cores)
                echo "---- Threads: ${threads} (balanced across ${#socket_cores[@]} sockets) ----"
                echo "Using CPUs: ${selected_cores}"
                taskset -c "${selected_cores}" $command
            done
            ;;
        sequential)
            # Fill sockets completely before moving to next
            for ((threads=1; threads<=total_cores; threads++)); do
                selected_cores=$(IFS=','; echo "${core_array[*]:0:$threads}")
                echo "---- Threads: ${threads} (sequential) ----"
                echo "Using CPUs: ${selected_cores}"
                taskset -c "${selected_cores}" $command
            done
            ;;
    esac
}

# Main script execution
detect_sockets

# Exit if no NUMA information found
if [[ ${#SOCKET_CPUS[@]} -eq 0 ]]; then
    echo "Error: Could not detect any NUMA sockets. Is numactl installed?"
    exit 1
fi

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -s|--socket)
            shift
            if [[ "$1" =~ ^[0-9]+$ ]]; then
                sockets+=("$1")
            else
                echo "Error: Invalid socket number '$1'"
                print_help
                exit 1
            fi
            ;;
        -c|--command)
            shift
            command=$@
            break
            ;;
        --strategy)
            shift
            case "$1" in
                balanced|sequential)
                    STRATEGY="$1"
                    ;;
                *)
                    echo "Error: Invalid strategy '$1'"
                    print_help
                    exit 1
                    ;;
            esac
            ;;
        --help)
            print_help
            exit 0
            ;;
        *)
            echo "Error: Invalid option '$1'"
            print_help
            exit 1
            ;;
    esac
    shift
done

# Validate we have a command to run
if [[ -z "$command" ]]; then
    echo "Error: No command specified"
    print_help
    exit 1
fi

# Determine which cores to use
cores=""
if [[ ${#sockets[@]} -eq 0 ]]; then
    # Use all cores if no sockets specified
    for socket_cpus in "${SOCKET_CPUS[@]}"; do
        cores="${cores} ${socket_cpus}"
    done
else
    # Add cores for each specified socket
    for socket in "${sockets[@]}"; do
        if [[ -z "${SOCKET_CPUS[$socket]}" ]]; then
            echo "Error: Socket $socket not found"
            print_help
            exit 1
        fi
        cores="${cores} ${SOCKET_CPUS[$socket]}"
    done
fi

# Prepare cores list (remove extra spaces and convert to comma-separated)
cores=$(echo $cores | xargs | tr ' ' ',')
max_cores=$(echo $cores | tr ',' ' ' | wc -w)

# Execute the benchmark
run_benchmark "$cores" "$max_cores" "$command"